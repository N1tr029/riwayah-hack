# Strava sync setup (~2 minutes, needs your Strava login):
#  1. Go to https://www.strava.com/settings/api and create an application
#     (any name/website; category "Training").
#  2. Set "Authorization Callback Domain" to exactly:  localhost
#  3. Copy this file to .env, paste Client ID and Client Secret below.
#  4. Restart the dev server (npx expo start) and rebuild the dev app if running natively.
# Then Run tab → Connect Strava → sign in → uploads carry GPS + heart rate.
EXPO_PUBLIC_STRAVA_CLIENT_ID=
EXPO_PUBLIC_STRAVA_CLIENT_SECRET=
